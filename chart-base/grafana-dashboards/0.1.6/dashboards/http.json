          "refId": "A",
          "expr": "(sum(count_over_time({log_type=\"http_access\", source=\"$source\", env=~\"$env\", project=~\"$project\", application=~\"$application\"} | json | RequestPath=~\"$path\" | DownstreamStatus >= 500 [$__range])) / sum(count_over_time({log_type=\"http_access\", source=\"$source\", env=~\"$env\", project=~\"$project\", application=~\"$application\"} | json | RequestPath=~\"$path\" [$__range])) * 100) or vector(0)",
          "queryType": "instant",
          "editorMode": "code"
        }
