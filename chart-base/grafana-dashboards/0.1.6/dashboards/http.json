      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "expr": "(sum(count_over_time({log_type=\"http_access\", source=\"$source\", env=~\"$env\", project=~\"$project\", application=~\"$application\"} | json | RequestPath=~\"$path\" [$__range]))) or vector(0)",
          "queryType": "instant",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
