          "expr": "topk(20, sum by (app, layer, class, method) (count_over_time({log_type=\"business\", env=~\"$env\", project=~\"$project\", app=~\"$app\", level=~\"$level\"} | level=\"error\" | json [$__range])))",
          "queryType": "instant",
          "editorMode": "code"
