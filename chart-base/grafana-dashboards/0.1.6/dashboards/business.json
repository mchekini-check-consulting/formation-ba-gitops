          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "app": "Service",
              "layer": "Couche",
              "class": "Classe",
              "method": "Méthode",
