          "refId": "A",
          "expr": "topk(10, quantile_over_time(0.95, {log_type=\"business\", env=~\"$env\", project=~\"$project\", app=~\"$app\", level=~\"$level\"} | layer=~\"controller|service\" | json | unwrap durationMs | __error__=\"\" [$__auto]) by (app, class, method))",
