          "expr": "{log_type=\"business\", env=~\"$env\", project=~\"$project\", app=~\"$app\", level=~\"$level\"} | layer=\"db\" | json | line_format `{{ .msg }}{{ if .class }} [{{ .class }}.{{ .method }}]{{ end }}{{ if .durationMs }} {{ .durationMs }}ms{{ end }}{{ if .status }} status={{ .status }}{{ end }}{{ if .query }} query={{ .query }}{{ end }}{{ if .errorMessage }} error={{ .errorMessage }}{{ end }}`",
          "queryType": "range",
          "editorMode": "code"
